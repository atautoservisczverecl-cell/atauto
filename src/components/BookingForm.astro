---
// Rezervace termínu (výměna oleje v převodovce / v motoru, diagnostika převodovky).
// Odesílá na stejnou serverovou funkci jako poptávka (/api/poptavka, form=rezervace).
// Termín je předběžný – servis ho potvrdí telefonicky nebo e-mailem.
import Icon from './Icon.astro';
import { site } from '../data/site';
export const bookingServices = [
  { id: 'olej-prevodovka', icon: 'oil', title: 'Výměna oleje v převodovce', text: 'Dynamická výměna s proplachem měniče a chladiče.', link: '/vymena-oleje-automaticka-prevodovka/#cenik', linkText: 'Orientační ceník' },
  { id: 'olej-motor', icon: 'drop', title: 'Výměna oleje v motoru', text: 'Motorový olej a filtr podle předpisu výrobce.' },
  { id: 'diagnostika', icon: 'scan', title: 'Diagnostika převodovky', text: 'Chybové kódy, živá data, kontrola oleje a zkušební jízda.', link: '/diagnostika-automaticke-prevodovky/', linkText: 'Co diagnostika obnáší' },
];
const brands = ['Alfa Romeo','Audi','BMW','Citroën','Cupra','Dacia','Fiat','Ford','Honda','Hyundai','Chevrolet','Chrysler','Jaguar','Jeep','Kia','Land Rover','Lexus','Mazda','Mercedes-Benz','Mini','Mitsubishi','Nissan','Opel','Peugeot','Porsche','Renault','Seat','Subaru','Suzuki','Škoda','Toyota','Volkswagen','Volvo','Jiná značka'];
const years = Array.from({ length: new Date().getFullYear() - 1989 }, (_, i) => new Date().getFullYear() - i);
const id = 'rez';
---
<form class="bform" id="rezervace-form" method="post" action="/api/poptavka" novalidate data-booking>
  <input type="hidden" name="form" value="rezervace" />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="hidden" name="ts" value="" />
  <div class="hp" aria-hidden="true"><label>Nevyplňujte <input type="text" name="web" tabindex="-1" autocomplete="off" /></label></div>

  <fieldset>
    <legend><span class="n">1</span> Služba</legend>
    <p class="hint">Můžete vybrat i víc služeb najednou.</p>
    <div class="svc-pick">
      {bookingServices.map((s) => (
        <label class="pick" id={`sluzba-${s.id}`}>
          <input type="checkbox" name="services" value={s.title} data-svc={s.id} />
          <span class="pick-box">
            <span class="pick-ic"><Icon name={s.icon} size={24} /></span>
            <span class="pick-t">{s.title}</span>
            <span class="pick-d">{s.text}</span>
            <span class="pick-check"><Icon name="check" size={16} /></span>
          </span>
        </label>
      ))}
    </div>
    <p class="svc-links">
      {bookingServices.filter((s) => s.link).map((s) => <a href={s.link}>{s.linkText} <Icon name="chevron" size={14} /></a>)}
    </p>
  </fieldset>

  <fieldset>
    <legend><span class="n">2</span> Termín</legend>
    <div class="row">
      <div class="f"><label for={`${id}-date`}>Preferovaný den *</label><input id={`${id}-date`} name="date" type="date" required /></div>
      <div class="f"><label for={`${id}-date2`}>Náhradní den</label><input id={`${id}-date2`} name="date_alt" type="date" /></div>
    </div>
    <p class="date-msg" aria-live="polite">Otevřeno {site.hours}. Víkendy a státní svátky nelze vybrat.</p>
    <div class="f">
      <span class="label" id={`${id}-tw`}>Kdy přijedete</span>
      <div class="chips" role="radiogroup" aria-labelledby={`${id}-tw`}>
        {['Dopoledne (8:30–12:00)', 'Odpoledne (12:00–17:30)', 'Je mi to jedno'].map((t, i) => (
          <label class="chip"><input type="radio" name="time" value={t} checked={i === 2} /><span>{t}</span></label>
        ))}
      </div>
    </div>
    <div class="f">
      <span class="label" id={`${id}-wait`}>Během servisu</span>
      <div class="chips" role="radiogroup" aria-labelledby={`${id}-wait`}>
        {['Počkám na místě', 'Nechám vůz v servisu', 'Domluvíme se'].map((t, i) => (
          <label class="chip"><input type="radio" name="wait" value={t} checked={i === 2} /><span>{t}</span></label>
        ))}
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend><span class="n">3</span> Vozidlo</legend>
    <div class="row">
      <div class="f"><label for={`${id}-brand`}>Značka *</label>
        <select id={`${id}-brand`} name="brand" required><option value="">Vyberte</option>{brands.map((b) => <option>{b}</option>)}</select></div>
      <div class="f"><label for={`${id}-model`}>Model *</label><input id={`${id}-model`} name="model" required placeholder="např. Octavia III" /></div>
    </div>
    <div class="row row-3">
      <div class="f"><label for={`${id}-year`}>Rok výroby</label><select id={`${id}-year`} name="year"><option value="">Vyberte</option>{years.map((y) => <option>{y}</option>)}<option>starší</option></select></div>
      <div class="f"><label for={`${id}-engine`}>Motorizace</label><input id={`${id}-engine`} name="engine" placeholder="např. 2.0 TDI 110 kW" /></div>
      <div class="f"><label for={`${id}-km`}>Stav km</label><input id={`${id}-km`} name="km" inputmode="numeric" placeholder="např. 160 000" /></div>
    </div>
    <div class="f"><label for={`${id}-vin`}>VIN nebo označení převodovky</label><input id={`${id}-vin`} name="vin" autocapitalize="characters" placeholder="Podle VIN připravíme správný olej a filtr" /></div>
  </fieldset>

  <fieldset>
    <legend><span class="n">4</span> Kontakt</legend>
    <div class="row">
      <div class="f"><label for={`${id}-name`}>Jméno a příjmení *</label><input id={`${id}-name`} name="name" autocomplete="name" required /></div>
      <div class="f"><label for={`${id}-phone`}>Telefon *</label><input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="+420" pattern="[+0-9 ()-]{9,}" /></div>
    </div>
    <div class="f"><label for={`${id}-email`}>E-mail</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" /></div>
    <div class="f"><label for={`${id}-msg`}>Poznámka</label><textarea id={`${id}-msg`} name="message" rows="3" placeholder="Např. převodovka občas cuká, poslední výměna oleje před 60 000 km…"></textarea></div>
  </fieldset>

  <p class="gdpr">Termín je předběžný. Potvrdíme vám ho telefonicky nebo e-mailem, obvykle ještě týž pracovní den. Údaje použijeme jen pro vyřízení rezervace. <a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a></p>
  <p class="err" role="alert" hidden></p>
  <button class="btn btn-red btn-submit" type="submit">Odeslat rezervaci <Icon name="arrow" /></button>
</form>
<div class="bsuccess" hidden tabindex="-1">
  <div class="ok-ic"><Icon name="check" size={28} /></div>
  <h3>Děkujeme, rezervaci jsme přijali</h3>
  <p class="sum"></p>
  <p>Termín vám potvrdíme telefonicky nebo e-mailem, obvykle ještě týž pracovní den ({site.hours}). Kdybyste potřebovali termín změnit, zavolejte na <a href={site.phoneHref} data-track="phone">{site.phone}</a>.</p>
  <p class="addr"><Icon name="pin" size={16} /> {site.street}, {site.zip} {site.city}</p>
  <p class="demo-note" hidden>Náhled webu: rezervace se uložila jen v tomto prohlížeči. Najdete ji v ukázce administrace.</p>
</div>

<style>
  .bform { display: grid; gap: 1.75rem; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: .9rem; min-width: 0; }
  legend { font: 600 .82rem var(--font-display); letter-spacing: .12em; text-transform: uppercase; color: var(--text); margin-bottom: .4rem; padding: 0; display: flex; align-items: center; gap: .6rem; }
  .n { display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 50%; background: var(--red); color: #fff; font-size: .8rem; letter-spacing: 0; }
  .hint, .date-msg { margin: 0; color: var(--text-soft); font-size: .9rem; }
  .date-msg.bad { color: var(--red); font-weight: 600; }
  .row { display: grid; gap: .9rem; }
  @media (min-width: 560px) { .row { grid-template-columns: 1fr 1fr; } .row-3 { grid-template-columns: 1fr 1fr 1fr; } }
  .f { display: grid; gap: .35rem; min-width: 0; }
  label, .label { font-weight: 600; font-size: .92rem; }
  input:not([type=radio]):not([type=checkbox]), select, textarea { width: 100%; font: inherit; font-size: 1rem; color: var(--text); background: #fff; border: 1px solid #c9ced4; border-radius: var(--radius); padding: .75rem .85rem; min-height: 48px; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--red); outline-offset: 1px; border-color: var(--red); }
  [aria-invalid=true] { border-color: var(--red) !important; background: var(--red-soft) !important; }

  .svc-pick { display: grid; gap: .75rem; }
  @media (min-width: 720px) { .svc-pick { grid-template-columns: repeat(3, 1fr); } }
  .pick { position: relative; cursor: pointer; font-weight: 400; }
  .pick input { position: absolute; opacity: 0; inset: 0; }
  .pick-box { position: relative; display: grid; gap: .35rem; height: 100%; padding: 1rem 1rem 1.1rem; border: 1.5px solid #c9ced4; border-radius: 8px; background: #fff; transition: border-color .15s, box-shadow .15s; }
  .pick-ic { color: var(--red); }
  .pick-t { font: 600 1.02rem/1.25 var(--font-display); color: var(--text); padding-right: 1.6rem; }
  .pick-d { font-size: .9rem; color: var(--text-soft); }
  .pick-check { position: absolute; top: .8rem; right: .8rem; width: 1.5rem; height: 1.5rem; border-radius: 50%; border: 1.5px solid #c9ced4; display: grid; place-items: center; color: transparent; }
  .pick input:checked + .pick-box { border-color: var(--red); box-shadow: 0 0 0 1px var(--red); }
  .pick input:checked + .pick-box .pick-check { background: var(--red); border-color: var(--red); color: #fff; }
  .pick input:focus-visible + .pick-box { outline: 2px solid var(--red); outline-offset: 2px; }
  .svc-pick.invalid .pick-box { border-color: var(--red); }
  .svc-links { display: flex; flex-wrap: wrap; gap: .4rem 1.25rem; margin: 0; font-size: .9rem; }
  .svc-links a { color: var(--text-soft); display: inline-flex; align-items: center; gap: .2rem; }

  .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { position: relative; font-weight: 400; }
  .chip input { position: absolute; opacity: 0; inset: 0; }
  .chip span { display: inline-block; padding: .55rem .9rem; border: 1px solid #c9ced4; border-radius: 999px; background: #fff; font-size: .92rem; cursor: pointer; }
  .chip input:checked + span { background: var(--ink); border-color: var(--ink); color: #fff; }
  .chip input:focus-visible + span { outline: 2px solid var(--red); outline-offset: 2px; }

  .hp { position: absolute; left: -9999px; }
  .gdpr { font-size: .85rem; color: var(--text-soft); margin: 0; }
  .err { margin: 0; color: var(--red); font-weight: 600; }
  .btn-submit { justify-self: start; }
  @media (max-width: 559px) { .btn-submit { justify-self: stretch; justify-content: center; } }
  .bsuccess { text-align: center; padding: 2rem 0; display: grid; gap: .75rem; justify-items: center; }
  .bsuccess h3 { font-family: var(--font-display); font-size: 1.5rem; margin: 0; }
  .bsuccess p { margin: 0; max-width: 52ch; color: var(--text-soft); }
  .bsuccess .sum { color: var(--text); font-weight: 600; }
  .bsuccess .addr { display: inline-flex; gap: .35rem; align-items: center; }
  .ok-ic { width: 56px; height: 56px; border-radius: 50%; background: var(--ok); color: #fff; display: grid; place-items: center; }
  .demo-note { font-size: .85rem; background: var(--paper); padding: .6rem .9rem; border-radius: 6px; }
</style>

<script>
  import { insert, blockedDays, live } from '../lib/cms-public';
  let blocked = new Set<string>();
  blockedDays().then((d) => (blocked = new Set(d)));
  // Státní svátky ČR (pevné + Velký pátek a Velikonoční pondělí)
  const easter = (y: number) => {
    const a = y % 19, b = Math.floor(y / 100), c = y % 100, d = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3);
    const h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
    const month = Math.floor((h + l - 7 * m + 114) / 31), day = ((h + l - 7 * m + 114) % 31) + 1;
    return new Date(y, month - 1, day);
  };
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const holidays = (y: number) => {
    const fixed = ['01-01', '05-01', '05-08', '07-05', '07-06', '09-28', '10-28', '11-17', '12-24', '12-25', '12-26'].map((md) => `${y}-${md}`);
    const e = easter(y); const fri = new Date(e); fri.setDate(e.getDate() - 2); const mon = new Date(e); mon.setDate(e.getDate() + 1);
    return new Set([...fixed, iso(fri), iso(mon)]);
  };
  const closedReason = (v: string) => {
    if (!v) return '';
    const d = new Date(v + 'T12:00:00');
    if (d.getDay() === 0 || d.getDay() === 6) return 'O víkendu máme zavřeno. Vyberte prosím pracovní den.';
    if (holidays(d.getFullYear()).has(v)) return 'Tento den je státní svátek a máme zavřeno. Vyberte prosím jiný den.';
    if (blocked.has(v)) return 'Tento den máme zavřeno nebo plno. Vyberte prosím jiný den.';
    return '';
  };
  const fmt = (v: string) => new Date(v + 'T12:00:00').toLocaleDateString('cs-CZ', { weekday: 'long', day: 'numeric', month: 'long' });

  document.querySelectorAll<HTMLFormElement>('form[data-booking]').forEach((form) => {
    const ts = form.querySelector<HTMLInputElement>('input[name=ts]'); if (ts) ts.value = String(Date.now());
    const err = form.querySelector<HTMLElement>('.err')!;
    const success = form.nextElementSibling as HTMLElement;
    const msg = form.querySelector<HTMLElement>('.date-msg')!;
    const defaultMsg = msg.textContent;
    const dates = form.querySelectorAll<HTMLInputElement>('input[type=date]');
    const pickWrap = form.querySelector<HTMLElement>('.svc-pick')!;
    const boxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name=services]'));

    // Nejbližší možný termín: další pracovní den
    const min = new Date(); min.setDate(min.getDate() + 1);
    while (closedReason(iso(min))) min.setDate(min.getDate() + 1);
    const max = new Date(); max.setDate(max.getDate() + 90);
    dates.forEach((el) => { el.min = iso(min); el.max = iso(max); });

    const check = (el: HTMLInputElement) => {
      const r = closedReason(el.value) || (el.value && (el.value < el.min || el.value > el.max) ? 'Vyberte prosím den v rozmezí příštích tří měsíců.' : '');
      el.setCustomValidity(r);
      if (r) { el.setAttribute('aria-invalid', 'true'); msg.textContent = r; msg.classList.add('bad'); }
      else { el.removeAttribute('aria-invalid'); if (![...dates].some((d) => d.validationMessage)) { msg.textContent = defaultMsg; msg.classList.remove('bad'); } }
    };
    dates.forEach((el) => el.addEventListener('change', () => check(el)));

    // Předvýběr služby z odkazu (#olej-prevodovka, #olej-motor, #diagnostika)
    const preselect = () => { const h = location.hash.slice(1); const b = boxes.find((x) => x.dataset.svc === h); if (b) { b.checked = true; pickWrap.classList.remove('invalid'); form.scrollIntoView({ behavior: 'smooth', block: 'start' }); } };
    const h0 = location.hash.slice(1); const b0 = boxes.find((x) => x.dataset.svc === h0); if (b0) b0.checked = true;
    window.addEventListener('hashchange', preselect);
    boxes.forEach((b) => b.addEventListener('change', () => pickWrap.classList.remove('invalid')));

    const showError = (m: string, field?: Element | null) => { err.textContent = m; err.hidden = false; (field as HTMLElement | null)?.focus(); };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      if (!boxes.some((b) => b.checked)) { pickWrap.classList.add('invalid'); return showError('Vyberte prosím alespoň jednu službu.', boxes[0]); }
      dates.forEach(check);
      form.querySelectorAll('[aria-invalid]').forEach((el) => { if (!(el as HTMLInputElement).validationMessage) el.removeAttribute('aria-invalid'); });
      const invalid = Array.from(form.querySelectorAll<HTMLInputElement>('input,select,textarea')).filter((el) => !el.checkValidity());
      if (invalid.length) {
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        const name = form.querySelector(`label[for="${invalid[0].id}"]`)?.textContent?.replace('*', '').trim();
        return showError(invalid[0].validationMessage && invalid[0].type === 'date' && closedReason(invalid[0].value) ? closedReason(invalid[0].value) : `Vyplňte prosím pole „${name ?? 'označené hvězdičkou'}“.`, invalid[0]);
      }
      const btn = form.querySelector<HTMLButtonElement>('.btn-submit')!;
      btn.disabled = true; const label = btn.innerHTML; btn.textContent = 'Odesílám…';
      const fd = new FormData(form);
      let demo = false, saved = false;
      const s = (k: string) => (String(fd.get(k) || '').trim() || null);
      try {
        await insert('bookings', { services: fd.getAll('services'), date: s('date'), date_alt: s('date_alt'), time_window: s('time'), wait: s('wait'), brand: s('brand'), model: s('model'), year: s('year'), engine: s('engine'), km: s('km'), vin: s('vin'), name: s('name'), phone: s('phone'), email: s('email'), message: s('message') });
        saved = true;
      } catch {}
      try {
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        if (res.status === 404 || res.status === 405) demo = true;
        else if (!res.ok) { const j = await res.json().catch(() => ({})); throw new Error(j.error || 'Odeslání se nepovedlo.'); }
      } catch (ex: any) {
        if (ex instanceof TypeError || location.hostname.endsWith('claude.ai') || location.protocol === 'file:') demo = true;
        else if (saved) { /* rezervace je v databázi, jen e-mail neodešel */ }
        else { btn.disabled = false; btn.innerHTML = label; return showError(`${ex.message} Zkuste to prosím znovu, nebo zavolejte na 721 004 440.`); }
      }
      const w = window as any; (w.dataLayer = w.dataLayer || []).push({ event: 'generate_lead', form_id: 'rezervace', services: fd.getAll('services').join(', '), page_path: location.pathname });
      success.querySelector<HTMLElement>('.sum')!.textContent = `${fd.getAll('services').join(' + ')} · ${fmt(String(fd.get('date')))}, ${String(fd.get('time')).replace('Je mi to jedno', 'čas dle domluvy')}`;
      form.hidden = true; success.hidden = false;
      if (demo && !live) success.querySelector<HTMLElement>('.demo-note')!.hidden = false;
      success.focus();
    });
  });
</script>
