---
// Galerie skutečných fotografií z dílny. Klik otevře plnou velikost.
const { photos, cols = 4 } = Astro.props as { photos: { src: string; alt: string; w?: number; h?: number }[]; cols?: number };
---
<ul class="gallery" style={`--cols:${cols}`}>
  {photos.map((p) => (
    <li>
      <a href={p.src.replace('-sm.webp', '.webp')} target="_blank" rel="noopener">
        <img src={p.src} alt={p.alt} width={p.w ?? 480} height={p.h ?? 640} loading="lazy" decoding="async" />
      </a>
    </li>
  ))}
</ul>
<style>
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; grid-template-columns: repeat(2, minmax(0,1fr)); }
  @media (min-width: 760px) { .gallery { grid-template-columns: repeat(var(--cols), minmax(0,1fr)); } }
  .gallery a { display: block; border-radius: 6px; overflow: hidden; aspect-ratio: 3 / 4; background: var(--steel); }
  .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s; }
  .gallery a:hover img { transform: scale(1.04); }
</style>
