  crumbs={[{ href: '/oprava-mechatroniky/', label: 'Oprava mechatroniky' }]}
  markdown={md}
  heroImage={{ src: '/img/realizace/zf-02.webp', alt: 'Hydraulický blok a mechatronika převodovky ZF', w: 1000, h: 1331 }}
  photos={[photos['vw-dq381'][0], photos['vw-dq381'][3], photos['jatco'][1], photos['ford'][2]]}
  related={[{ href: '/znacky/dsg-dq381/', label: 'Mechatronika DSG DQ381' }, { href: '/diagnostika-automaticke-prevodovky/', label: 'Diagnostika' }, { href: '/chybove-kody-prevodovek/', label: 'Chybové kódy' }]}
