---
import Content from '../layouts/Content.astro';
import md from '../texts/mechatronika.md?raw';
import { photos } from '../data/photos';
---
<Content
  title="Oprava mechatroniky převodovky | DSG, ZF, PowerShift | A.T. Autoservis"
  description="Diagnostika, oprava a repas mechatroniky automatických převodovek DSG, ZF 6HP/8HP, Ford PowerShift, Aisin a Multitronic. Solenoidy, snímače, TCM, hydraulický blok."
  eyebrow="Mechatronika a řídicí jednotky" h1="Oprava mechatroniky převodovky"
