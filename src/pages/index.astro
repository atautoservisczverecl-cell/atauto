---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site, yearsOnMarket } from '../data/site';
import { cmsServices } from '../data/cms';
import { photos } from '../data/photos';

const symptoms = [
  { icon: 'jerk', title: 'Cuká nebo tvrdě řadí', text: 'Rázy při přeřazení, hlavně za studena nebo při rozjezdu.', href: '/blog/proc-automaticka-prevodovka-cuka/' },
  { icon: 'slip', title: 'Prokluzuje', text: 'Otáčky vyletí nahoru, ale auto nezrychluje.', href: '/diagnostika-automaticke-prevodovky/#prokluzovani' },
  { icon: 'warn', title: 'Nouzový režim', text: 'Svítí kontrolka, auto jede jen na jeden převodový stupeň.', href: '/diagnostika-automaticke-prevodovky/#nouzovy-rezim' },
  { icon: 'noise', title: 'Hučí, píská nebo klepe', text: 'Zvuk, který se mění s rychlostí nebo se zařazeným stupněm.', href: '/diagnostika-automaticke-prevodovky/#hlucnost' },
  { icon: 'drop', title: 'Uniká olej', text: 'Červené nebo hnědé skvrny pod autem po odstavení.', href: '/oprava-automaticke-prevodovky/#unik-oleje' },
  { icon: 'delay', title: 'Zpožděný záběr D / R', text: 'Po zařazení D nebo R chvíli trvá, než auto „chytne“.', href: '/diagnostika-automaticke-prevodovky/#zpozdeny-zaber' },
];

const services = cmsServices.map((s) => ({ icon: s.icon, title: s.title, text: s.summary, href: s.href }));

const types = [
  { make: 'VW · Škoda · Audi · Seat', name: 'DSG', codes: ['DQ200 / 0AM', 'DQ250 / 02E', 'DQ381 / 0GC'], href: '/typy-prevodovek/dsg/' },
  { make: 'BMW · Audi · Jaguar · Land Rover', name: 'ZF 6HP / 8HP', codes: ['6HP26', '8HP50', '8HP70'], href: '/znacky/zf/' },
  { make: 'Volvo · Peugeot · Citroën · Opel', name: 'Aisin Warner', codes: ['TF-80SC', 'TF-60SN / 09G', 'AWF8F35'], href: '/znacky/aisin/' },
  { make: 'Ford · Volvo', name: 'PowerShift', codes: ['6DCT250 / DPS6', '6DCT450 / MPS6'], href: '/znacky/ford-powershift/' },
  { make: 'Nissan · Mitsubishi · Toyota', name: 'CVT', codes: ['JF011E', 'JF016E', 'K310 / K311'], href: '/typy-prevodovek/cvt/' },
  { make: 'Audi', name: 'Multitronic', codes: ['01J', '0AW'], href: '/typy-prevodovek/multitronic/' },
];

const steps = [
  { t: 'Diagnostika', d: 'Přečteme chybové kódy, změříme tlaky, zkontrolujeme olej a projedeme se s vozem. Hledáme skutečnou příčinu.' },
  { t: 'Návrh řešení a cena', d: 'Vysvětlíme, co je vadné, a navrhneme opravu nebo repasi. Cenu a termín znáte předem.' },
  { t: 'Oprava s vaším souhlasem', d: 'Pracujeme až po odsouhlasení. Když během opravy najdeme něco dalšího, nejdřív vám zavoláme.' },
  { t: 'Kontrola a testování', d: 'Adaptace, kontrola těsnosti a zkušební jízda. Auto předáme s vysvětlením, co jsme dělali.' },
];

const reasons = [
  { t: `Od roku ${site.since}`, d: 'Začínali jsme opravami automatů amerických vozů. Dnes opravujeme převodovky od nejstarších po nejmodernější.' },
  { t: 'Jen automatické převodovky', d: 'Nejsme univerzální servis. Převodovky jsou naše hlavní práce, ne doplňková služba.' },
  { t: 'Diagnostika před opravou', d: 'Jeden chybový kód automaticky neznamená výměnu dílu. Rozsah opravy určujeme podle skutečného stavu.' },
  { t: 'Moderní vybavení', d: 'Diagnostické přístroje, zařízení na dynamickou výměnu oleje a nářadí pro práci s mechatronikami.' },
  { t: 'Individuální přístup', d: 'Každou převodovku posuzujeme zvlášť podle vozu, nájezdu a historie. Neměníme díly „pro jistotu“.' },
  { t: 'Záruka až 24 měsíců', d: 'Na nové díly poskytujeme záruku 24 měsíců, na repasované 6 měsíců. Záruční prohlídku po 1 000 km děláme zdarma.' },
];

const faq = [
  { q: 'Kolik stojí oprava automatické převodovky?', a: 'Cena závisí na typu převodovky a rozsahu závady. Jinak vychází oprava mechatroniky, jinak výměna těsnění a jinak kompletní repase. Přesnou cenu proto stanovíme po diagnostice a před zahájením práce ji s vámi odsouhlasíme. Bez vašeho souhlasu nic navíc neúčtujeme. ' + site.priceDiag + ' Orientační ceny výměny oleje najdete v <a href="/vymena-oleje-automaticka-prevodovka/#cenik">ceníku</a>.' },
  { q: 'Musí se při závadě vždy dělat kompletní repase?', a: 'Ne. Řada závad jde vyřešit opravou mechatroniky, hydrauliky, měniče nebo jiné konkrétní části. O rozsahu opravy rozhoduje diagnostika a skutečný stav převodovky.' },
  { q: 'Jaké převodovky opravujete?', a: 'Klasické hydrodynamické automaty (ZF, Aisin Warner, Mercedes-Benz, Jatco, GM), dvouspojkové DSG a PowerShift, CVT včetně Multitronicu a další typy. Opravujeme převodovky vozů všech značek.' },
  { q: 'Jaká je záruka na opravu?', a: `${site.warrantyDetail} Podrobnosti najdete v <a href="/obchodni-podminky/">obchodních podmínkách</a>.` },
  { q: 'Stačí vyměnit olej, když převodovka cuká?', a: 'Někdy ano, často ne. Výměna oleje je správný servisní úkon, ale opotřebenou mechanickou nebo hydraulickou část neopraví. Proto doporučujeme nejdřív diagnostiku.' },
  { q: 'Jak se objednat?', a: `Zavolejte na <a href="${site.phoneHref}">${site.phone}</a> (${site.hours}) nebo vyplňte <a href="/poptavka/">poptávkový formulář</a>. Pomůže, když uvedete značku, model, rok výroby, motor a popis závady.` },
];

const gallery = [photos['zf'][1], photos['vw-dq381'][2], photos['jatco'][5], photos['toyota'][2], photos['ford'][1], photos['mitsubishi'][2], photos['zf'][6], photos['aisin'][1]];

const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) };
---
<Base title="Oprava a repase automatických převodovek | A.T. Autoservis Praha-západ" description={`Specialisté na automatické převodovky od roku ${site.since}. Diagnostika, opravy a repase DSG, ZF, Aisin, CVT i PowerShift. Hostivice u Prahy, záruka ${site.warranty}.`} schema={[faqSchema]}>

  <section class="hero dark">
    <div class="wrap hero-in">
      <div class="hero-text">
        <p class="eyebrow">Specializovaný servis · Hostivice u Prahy</p>
        <h1>Oprava a repase <span>automatických</span> převodovek</h1>
        <p class="lead">DSG, ZF, Aisin, CVT, PowerShift i Multitronic. Nejdřív přesná diagnostika, potom oprava, kterou vám předem vysvětlíme a naceníme. Se zárukou {site.warranty}.</p>
        <div class="btn-row">
          <a class="btn btn-red btn-lg" href="/rezervace/#diagnostika">Objednat diagnostiku</a>
          <a class="btn btn-ghost btn-lg" href={site.phoneHref} data-track="phone">Zavolat {site.phoneShort}</a>
        </div>
      </div>
      <figure class="hero-gear">
        <img src="/img/ui/prevodovka-hero.webp" srcset="/img/ui/prevodovka-hero-sm.webp 640w, /img/ui/prevodovka-hero.webp 1200w" sizes="(min-width: 960px) 45vw, 100vw" width="1200" height="800" alt="Řez automatickou převodovkou s měničem točivého momentu, lamelovými spojkami a planetovými soukolími" fetchpriority="high" />
      </figure>
    </div>
    <div class="wrap">
      <ul class="trust">
        <li><strong>od {site.since}</strong><span>na českém trhu</span></li>
        <li><strong>100 %</strong><span>specializace na automatické převodovky</span></li>
        <li><strong>všechny typy</strong><span>DSG, CVT, klasické automaty, PowerShift</span></li>
        <li><strong>až 24 měs.</strong><span>záruka na provedené opravy</span></li>
      </ul>
    </div>
  </section>

  <section class="section" id="priznaky">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">Příznaky závady</p><h2>Co dělá vaše převodovka?</h2></div>
        <p class="lead">Čím dřív závadu zachytíme, tím levnější bývá oprava. Poznáte některý z těchto příznaků?</p>
      </div>
      <div class="grid grid-3">
        {symptoms.map((s) => (
          <a class="sym card" href={s.href}>
            <span class="sym-ic"><Icon name={s.icon} size={22} /></span>
            <span><strong>{s.title}</strong><span>{s.text}</span></span>
          </a>
        ))}
      </div>
      <div class="sym-cta">
        <div><strong>Nevíte si rady? Popište nám příznaky.</strong><span>Ozveme se obvykle ještě týž pracovní den a řekneme vám, jak postupovat.</span></div>
        <a class="btn btn-red" href="/poptavka/">Poptat diagnostiku <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section light" id="sluzby">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">Naše specializace</p><h2>Co pro vás uděláme</h2></div>
        <p class="lead">Automatické převodovky jsou jediné, čemu se věnujeme naplno. Od diagnostiky po kompletní repasi.</p>
      </div>
      <div class="grid grid-4">
        {services.map((s) => (
          <a class="svc" href={s.href}>
            <span class="svc-ic"><Icon name={s.icon} size={26} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="more">Více <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
      <p class="also">Opravujeme také <a href="/oprava-mechatroniky/">mechatroniky a řídicí jednotky</a> a <a href="/chybove-kody-prevodovek/">vysvětlíme chybové kódy</a>. Stálým zákazníkům zajistíme i servisní prohlídku, výměnu oleje v motoru, plnění klimatizace a pneuservis. <strong>Výměnu oleje v převodovce či motoru a diagnostiku si můžete <a href="/rezervace/">rezervovat online</a>.</strong></p>
    </div>
  </section>

  <section class="section dark" id="typy">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">Typy převodovek</p><h2>Opravujeme téměř všechny automaty</h2></div>
        <p class="lead">Každý typ má vlastní stránku s typickými závadami, postupem opravy a fotografiemi z realizací.</p>
      </div>
      <div class="types">
        {types.map((t) => (
          <a class="type" href={t.href}>
            <span class="type-make">{t.make}</span>
            <strong>{t.name}</strong>
            <span class="tags">{t.codes.map((c) => <span class="tag">{c}</span>)}</span>
            <span class="more">Závady a opravy <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
      <p class="types-more">Opravujeme i převodovky Mercedes-Benz (7G-Tronic, 9G-Tronic), GM, Jatco, Hyundai a Kia. <a href="/znacky/">Všechny značky a výrobci</a> · <a href="/typy-prevodovek/">Přehled technologií</a></p>
    </div>
  </section>

  <section class="section" id="proc-my">
    <div class="wrap why">
      <div>
        <p class="eyebrow">Proč my</p>
        <h2>Proč svěřit převodovku právě nám</h2>
        <p class="lead">Automatická převodovka je kombinace mechaniky, hydrauliky a elektroniky. Správná oprava začíná správnou diagnózou.</p>
        <figure class="why-img"><img src="/img/realizace/zf-03-sm.webp" width="480" height="639" alt="Hydraulický blok převodovky ZF při kontrole" loading="lazy" /></figure>
      </div>
      <ul class="reasons">
        {reasons.map((r) => <li><Icon name="check" size={22} /><div><h3>{r.t}</h3><p>{r.d}</p></div></li>)}
      </ul>
    </div>
  </section>

  <section class="section graphite" id="postup">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">Postup</p><h2>Jak probíhá oprava nebo repase</h2></div>
        <p class="lead">Bez zbytečného čekání a bez překvapení na faktuře.</p>
      </div>
      <ol class="steps4">
        {steps.map((s, i) => <li><span class="n">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section light" id="realizace">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">Realizace</p><h2>Ukázky z naší dílny</h2></div>
        <p class="lead">Skutečné fotografie z oprav převodovek ZF, DSG DQ381, Jatco CVT, Toyota, Ford PowerShift a dalších.</p>
      </div>
      <ul class="rgal">
        {gallery.map((p) => <li><img src={p.src} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" /></li>)}
      </ul>
      <a class="btn btn-dark" href="/realizace/">Všechny realizace <Icon name="arrow" /></a>
    </div>
  </section>

  <section class="section" id="kody">
    <div class="wrap codes-teaser">
      <div>
        <p class="eyebrow">Chybové kódy</p>
        <h2>Svítí kontrolka? Zjistěte, co znamená chybový kód</h2>
        <p class="lead">Databáze nejčastějších kódů převodovek DSG, ZF, Aisin, CVT a PowerShift s vysvětlením typických příčin.</p>
      </div>
      <form class="code-search" action="/chybove-kody-prevodovek/" method="get" data-code-jump>
        <label for="home-code">Zadejte kód</label>
        <div class="cs-row">
          <input id="home-code" name="kod" placeholder="např. P0741 nebo P17BF" autocomplete="off" />
          <button class="btn btn-red" type="submit"><Icon name="search" /> Hledat</button>
        </div>
        <p class="cs-ex">Časté: <a href="/chybove-kody-prevodovek/#P0741">P0741</a> <a href="/chybove-kody-prevodovek/#P0868">P0868</a> <a href="/chybove-kody-prevodovek/#P17BF">P17BF</a> <a href="/chybove-kody-prevodovek/#P0730">P0730</a></p>
      </form>
    </div>
  </section>

  <section class="section light" id="recenze">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">Zkušenosti zákazníků</p><h2>Co o nás říkají zákazníci</h2></div>
        <div class="award"><img src="/img/ui/firmy-top-2025.webp" width="287" height="262" alt="Firmy.cz TOP FIRMA 2025" loading="lazy" /><p>Ocenění <strong>TOP FIRMA 2025</strong> na portálu Firmy.cz</p></div>
      </div>
      <div class="reviews-card">
        <svg class="g-logo" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        <div class="reviews-txt">
          <strong>Hodnocení zákazníků na Google</strong>
          <p>Přečtěte si, jak jsou s námi spokojeni zákazníci. A pokud jste u nás byli na opravě, budeme rádi za vaše hodnocení.</p>
        </div>
        <a class="btn btn-red" href="https://share.google/9ChWZNsHRwg9lxCkk" target="_blank" rel="noopener">Přečíst recenze na Google ↗</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow"><Faq items={faq} /></div>
  </section>

  <section class="section dark" id="kontakt">
    <div class="wrap contact">
      <div class="contact-card">
        <p class="eyebrow">Kontakt</p>
        <h2>Kde nás najdete</h2>
        <a class="big-phone" href={site.phoneHref} data-track="phone">{site.phone}</a>
        <dl>
          <dt>Adresa</dt><dd>{site.street}, {site.zip} {site.city}<br />{site.region}</dd>
          <dt>Otevřeno</dt><dd>{site.hours}</dd>
          <dt>E-mail</dt><dd><a href={`mailto:${site.email}`} data-track="email">{site.email}</a></dd>
          <dt>Firma</dt><dd>{site.legalName}, IČO {site.ico}</dd>
        </dl>
        <div class="btn-row">
          <a class="btn btn-ghost" href={site.mapUrl} target="_blank" rel="noopener"><Icon name="pin" /> Google Mapy</a>
          <a class="btn btn-ghost" href="https://mapy.cz/zakladni?q=N%C3%A1dra%C5%BEn%C3%AD%20272%20Hostivice" target="_blank" rel="noopener"><Icon name="pin" /> Mapy.cz</a>
        </div>
      </div>
      <div class="contact-form">
        <h2>Poptejte opravu</h2>
        <p>Vyplnění zabere minutu. Podrobnější formulář s přílohami najdete na stránce <a href="/poptavka/">Poptávka</a>.</p>
        <InquiryForm compact id="home-form" />
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-code-jump]').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = (f.querySelector('input') as HTMLInputElement).value.trim().toUpperCase().replace(/\s+/g, '');
    location.href = f.getAttribute('action') + (v ? '#' + encodeURIComponent(v) : '');
  }));
</script>

<style>
  .btn-lg { padding: 1rem 1.5rem; font-size: 1.08rem; }
  .hero { padding-top: clamp(2.5rem, 2rem + 3vw, 5rem); padding-bottom: 0; position: relative; overflow: hidden; }
  .hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(60% 70% at 85% 30%, rgba(217,39,29,.16), transparent 70%); pointer-events: none; }
  .hero-in { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 960px) { .hero-in { grid-template-columns: 1.1fr .9fr; gap: 3rem; } }
  .hero-text { display: grid; gap: 1.3rem; justify-items: start; }
  .hero h1 { font-size: clamp(2.15rem, 1.2rem + 3.8vw, 4.1rem); line-height: 1.04; text-transform: uppercase; letter-spacing: .005em; max-width: 14ch; }
  @media (max-width: 479px) { .hero .eyebrow { font-size: .74rem; letter-spacing: .1em; } }
  .hero h1 span { color: var(--red); display: block; }
  @media (max-width: 959px) { .hero .btn-row { display: grid; width: 100%; gap: .8rem; } .hero .btn-row .btn { justify-content: center; width: 100%; } }
  .hero-note { display: inline-flex; gap: .45rem; align-items: center; color: var(--on-dark-soft); font-size: .92rem; }
  .hero-note a { color: var(--on-dark); text-underline-offset: 3px; }
  .hero-gear { margin: 0; position: relative; }
  .hero-gear::before { content: ""; position: absolute; inset: -8% -4%; background: radial-gradient(closest-side, rgba(217,39,29,.2), transparent); }
  .hero-gear img { position: relative; width: 100%; height: auto; filter: drop-shadow(0 24px 40px rgba(0,0,0,.55)); }
  @media (max-width: 959px) { .hero-gear { order: -1; max-width: 560px; justify-self: center; margin-bottom: -1rem; } }
  .trust { list-style: none; margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); border-top: 1px solid var(--line-dark); }
  @media (min-width: 900px) { .trust { grid-template-columns: repeat(4, minmax(0,1fr)); } }
  .trust li { padding: 1.4rem 1rem 1.6rem 0; display: grid; gap: .2rem; border-right: 1px solid var(--line-dark); padding-left: 1rem; }
  .trust li:first-child, .trust li:nth-child(3) { padding-left: 0; }
  @media (min-width: 900px) { .trust li:nth-child(3) { padding-left: 1rem; } }
  .trust li:last-child { border-right: 0; }
  @media (max-width: 899px) { .trust li:nth-child(2) { border-right: 0; } .trust li:nth-child(-n+2) { border-bottom: 1px solid var(--line-dark); } }
  .trust strong { font: 700 clamp(1.3rem, 1rem + 1.2vw, 1.85rem) var(--font-display); color: #fff; }
  .trust span { color: var(--on-dark-soft); font-size: .9rem; line-height: 1.4; }

