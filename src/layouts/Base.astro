---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Consent from '../components/Consent.astro';
import { site } from '../data/site';
import { cmsSeo } from '../data/cms';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  breadcrumbs?: { href: string; label: string }[];
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}
const props = Astro.props;
const seo = cmsSeo.get(Astro.url.pathname.replace(/^\/|\/$/g, ''));
const title = seo?.seo_title || props.title;
const description = seo?.seo_description || props.description;
const noindex = seo?.noindex ?? props.noindex ?? false;
const { schema = [], breadcrumbs, image = '/og-image.jpg', type = 'website' } = props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${site.url}/#firma`,
  name: site.name,
  legalName: site.legalName,
  url: site.url + '/',
  logo: `${site.url}/img/ui/logo-white.png`,
  image: `${site.url}/og-image.jpg`,
  telephone: site.phone.replace(/\s/g, ''),
  email: site.email,
  taxID: site.dic,
  vatID: site.dic,
  foundingDate: String(site.since),
  priceRange: 'Kč',
  hasMap: site.mapUrl,
  address: { '@type': 'PostalAddress', streetAddress: site.street, addressLocality: site.city, postalCode: site.zip.replace(' ', ''), addressRegion: 'Středočeský kraj', addressCountry: 'CZ' },
  areaServed: [{ '@type': 'City', name: 'Praha' }, { '@type': 'AdministrativeArea', name: 'Středočeský kraj' }, { '@type': 'Country', name: 'Česká republika' }],
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: site.hoursSchema.days, opens: site.hoursSchema.opens, closes: site.hoursSchema.closes }],
  knowsAbout: ['automatické převodovky', 'DSG', 'CVT', 'ZF 8HP', 'Aisin', 'Ford PowerShift', 'mechatronika', 'měnič točivého momentu'],
};
const crumbSchema = breadcrumbs && breadcrumbs.length ? [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ href: '/', label: 'Úvod' }, ...breadcrumbs].map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.label, item: new URL(b.href, site.url).href })),
}] : [];
const allSchema = [business, ...crumbSchema, ...schema];
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="claude:viewport-fit-sides" content="cover" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#131416" />
  <meta property="og:locale" content="cs_CZ" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="A.T. Autoservis" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/chakra-petch-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/figtree-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });
  </script>
  {site.gtmId && (
    <script is:inline define:vars={{ id: site.gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',id);
    </script>
  )}
  {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#obsah">Přeskočit na obsah</a>
  <Header />
  <main id="obsah">
    <slot />
  </main>
  <Footer />
  <MobileBar />
  <Consent />
  <script>
    import { startTracking } from '../lib/cms-public';
    startTracking();
  </script>
  <script>
    // Měření konverzí: kliknutí na telefon a e-mail (dataLayer pro GTM / GA4 / Google Ads)
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a');
      if (!a) return;
      const href = a.getAttribute('href') || '';
      const w = window as any; w.dataLayer = w.dataLayer || [];
      if (href.startsWith('tel:')) w.dataLayer.push({ event: 'click_phone', link_url: href, page_path: location.pathname });
      else if (href.startsWith('mailto:')) w.dataLayer.push({ event: 'click_email', link_url: href, page_path: location.pathname });
      else if (href.includes('/poptavka/')) w.dataLayer.push({ event: 'cta_inquiry', page_path: location.pathname });
      else if (href.includes('/rezervace/')) w.dataLayer.push({ event: 'cta_booking', page_path: location.pathname });
    });
  </script>
</body>
</html>
